# ============================================================
# AIMRS — .gitignore
# ============================================================

# ─── Environment files (NEVER commit secrets) ────────────────
.env
.env.local
.env.*.local
.env.production

# ─── MCP server config (contains API tokens) ─────────────────
.mcp.json

# ─── Node ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Next.js ─────────────────────────────────────────────────
Frontend/.next/
Frontend/out/
Frontend/build/

# ─── NestJS / TypeScript build output ────────────────────────
Backend/dist/
Backend/build/

# ─── Testing ─────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Docker ──────────────────────────────────────────────────
.docker/

# ─── Generated reports/forms (runtime artifacts) ─────────────
Backend/uploads/
Backend/generated/

# ─── TypeScript incremental build info ───────────────────────
*.tsbuildinfo
