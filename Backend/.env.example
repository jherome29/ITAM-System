# =============================================================
# AIMRS Backend — environment variables
# Copy to Backend/.env and fill in real values. NEVER commit .env.
# =============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3001

# ── Database ─────────────────────────────────────────────────
# Supabase (dev) or raw PostgreSQL (prod). Code must run on raw PG —
# no Supabase-specific client features.
DATABASE_URL=postgresql://user:pass@host:5432/aimrs

# TLS on the DB connection. Default (unset) = verified SSL, required by
# Supabase and managed production Postgres.
#   disable    → no SSL              (local docker-compose / CI Postgres)
#   no-verify  → SSL, cert NOT checked (a dev box behind a TLS-intercepting
#                proxy — set it here, never in code)
DATABASE_SSL=

# Connection pool ceiling. pg default is 10; keep <= Postgres max_connections.
DB_POOL_MAX=20

# ── JWT ──────────────────────────────────────────────────────
# Secrets must be >= 32 random chars (Joi enforces at startup).
#   openssl rand -hex 64
JWT_SECRET=change-me-min-32-random-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-another-32-random-characters
JWT_REFRESH_EXPIRES_IN=7d

# ── HTTP / proxy ─────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# Proxy hops to trust so req.ip / audit-log IPs are the real client, not
# the reverse proxy. Set to 1 in production (behind CICC IT's proxy);
# leave unset / 0 when the app is directly exposed (a spoofable header
# otherwise).
TRUST_PROXY=

# ── Rate limiting (per IP) ───────────────────────────────────
THROTTLE_TTL=60000           # window, ms
THROTTLE_LIMIT=60            # requests per window

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Supabase (dev/test only — remove for production) ─────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
