# Docker Compose environment variables
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# Then run:
#   docker-compose --env-file .env.docker up --build

# Local PostgreSQL container password (dev only — choose any password)
POSTGRES_PASSWORD=choose_a_local_dev_password

# Must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://aimrs_user:choose_a_local_dev_password@postgres:5432/aimrs_dev

# Must be at least 32 random characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string_generated_by_command_above

JWT_EXPIRES_IN=8h
ALLOWED_ORIGIN=http://localhost:3000
